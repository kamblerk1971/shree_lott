  Widget _bottomSummary() {
    final selections = controller.model.collectAllNumbersForPrint();
    final keys = selections.keys;

    final int slotMultiplier = slots.isEmpty ? 1 : slots.length;

    final int baseQty = controller.model.getTotalQuantityAllSelected();

    double totalAmount = 0.0;

    final List<int> multipliers = [1, 1, 2, 3, 5, 5, 10, 20, 25, 25];

    // ==========================================================
    // LOW MODE → use existing total
    // ==========================================================
    if (!controller.model.high) {
      final double baseAmount = controller.model.getTotalAmountAllSelected();

      totalAmount = baseAmount * slotMultiplier;
    }
    // ==========================================================
    // HIGH MODE → calculate with multiplier
    // ==========================================================
    else {
      for (final entry in selections.entries) {
        final int number = entry.key;
        final int qty = entry.value;

        final int rangeIndex = (number % 1000) ~/ 100;

        int multiplier = 1;

        if (rangeIndex >= 0 && rangeIndex < multipliers.length) {
          multiplier = multipliers[rangeIndex];
        }

        totalAmount += qty * controller.model.selectedPoint * multiplier;
      }

      totalAmount *= slotMultiplier;
    }

    final int totalQty = baseQty * slotMultiplier;

    // ==========================================================
    // SELECTED NUMBERS TEXT
    // ==========================================================

    String selectedNumbersText() {
      if (keys.isEmpty) {
        return 'No numbers selected';
      }

      const int limit = 99;

      final numbers = keys.toList()..sort();

      final padded = numbers.map((e) => e.toString().padLeft(4, '0')).toList();

      final visible = padded.take(limit).join(', ');
      final remaining = padded.length - limit;

      if (padded.length > limit) {
        return 'Selected numbers: $visible +$remaining more';
      }

      return 'Selected numbers: $visible';
    }

    return Row(
      mainAxisAlignment: MainAxisAlignment.end,
      children: [
        // Expanded(
        //   child: Text(
        //     selectedNumbersText(),
        //     style: const TextStyle(
        //       fontSize: 8,
        //       fontWeight: FontWeight.w600,
        //       color: Color(0xFF222222),
        //     ),
        //   ),
        // ),
        const SizedBox(width: 16),

        _summaryItem(
          'Total QTY',
          totalQty.toString(),
          Icons.format_list_numbered,
        ),

        const SizedBox(width: 16),

        _summaryItem(
          'Total Amount',
          '₹${totalAmount.toStringAsFixed(2)}',
          Icons.attach_money,
        ),
      ],
    );
  }

